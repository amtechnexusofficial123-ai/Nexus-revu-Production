# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/reviewflow?sslmode=require

# Random long string used to sign session cookies. Generate with:
# openssl rand -base64 32
AUTH_SECRET=

# Google Gemini API key (optional — enables AI review drafting when set)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the primary model (default gemini-3.6-flash).
# On API error, the app automatically retries with gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.6-flash

# Razorpay subscriptions (optional — Questions QR billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_1500=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_TOTAL_COUNT=20

# Optional: per-business review velocity caps (defaults shown)
# REVIEW_MAX_DRAFTS_PER_HOUR=10
# REVIEW_MAX_DRAFTS_PER_DAY=35
# REVIEW_MAX_POSTS_PER_HOUR=8
# REVIEW_MAX_POSTS_PER_DAY=25

